PORT=4000
MONGODB_URI=mongodb://localhost:27017/family_comes_first
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Pinned to a free, non-reasoning instruct model — avoids the random
# openrouter/free auto-router landing on a reasoning model that leaks its
# chain-of-thought into the response. Set a paid model id (e.g.
# anthropic/claude-opus-5) instead if you want higher-quality phrasing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
