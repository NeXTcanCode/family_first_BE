PORT=4000
MONGODB_URI=mongodb://localhost:27017/family_comes_first
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# openrouter/free is OpenRouter's zero-cost auto-router (picks a free model
# per request). Set a specific model id instead (e.g. anthropic/claude-opus-5)
# to pin a paid model — OpenRouter always requires a "model" field.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
